# 계약나침반 환경설정 — 복사해서 .env 로 저장 후 값 채우기
# (전부 선택 사항 — LLM 키 없이도 룰엔진·법령 검색은 동작, AI 설명·챗봇만 비활성)

# LLM (설명 생성·챗봇) — openai | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# 전역 일일 LLM 호출 상한(과금 방지 서킷브레이커). 0 이하 = 무제한
OPENAI_DAILY_CALL_CAP=200
GEMINI_API_KEY=

# 관리자 API 토큰 (미설정 시 admin 엔드포인트 503 fail-closed)
ADMIN_TOKEN=

# law.go.kr Open API (법령 재수집용 — 서버 IP 사전 등록 필요, 선택)
LAW_API_KEY=

# Cohere Rerank (선택 — 미설정 시 rerank 없이 동작, 무료 운영 기본)
COHERE_API_KEY=

# 자체 GPU 서빙(폐쇄망·비용 절감용, 선택)
# OPENAI_BASE_URL=http://gpu:8000/v1
# EMBEDDING_ENDPOINT=http://gpu:8080/v1
# RERANK_ENDPOINT=http://gpu:8081
